generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ESCRITÓRIO E USUÁRIOS ====================

model Escritorio {
  id          String   @id @default(cuid())
  nome        String
  cnpj        String?
  endereco    String?
  telefone    String?
  email       String?
  logo        String?

  plano       String   @default("free")
  limiteUsuarios Int   @default(1)
  limitePedidos  Int   @default(10)

  usuarios    User[]
  pastas      Pasta[]
  teses       Tese[]
  modelosDocumento ModeloDocumento[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("escritorios")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  oab           String?
  telefone      String?
  avatar        String?

  role          String    @default("advogado")

  tema          String    @default("dark")
  notificacoesEmail Boolean @default(true)
  notificacoesWhatsapp Boolean @default(false)
  whatsapp      String?

  escritorioId  String?
  escritorio    Escritorio? @relation(fields: [escritorioId], references: [id])

  configuracoes UserConfig?
  pedidos       Pedido[]
  comentarios   Comentario[]
  notificacoes  Notificacao[]
  prazos        Prazo[]
  teses         Tese[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model UserConfig {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Configurações de formatação (nomes compatíveis com API)
  fonte           String  @default("Times New Roman")
  tamanhoFonte    Int     @default(12)
  espacamentoLinha Float  @default(1.5)
  margemSuperior  Float   @default(3.0)
  margemInferior  Float   @default(2.0)
  margemEsquerda  Float   @default(3.0)
  margemDireita   Float   @default(2.0)
  alinhamentoTexto String @default("justify")

  // Cabeçalho e Rodapé
  cabecalho       String?
  rodape          String?
  numeracaoPaginas Boolean @default(true)

  // Assinatura
  assinaturaDigital String?
  logoUrl         String?

  // Modelo de documento base (arquivo .docx)
  modeloBaseUrl   String?
  modeloBaseNome  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("user_configs")
}

// ==================== MODELOS DE DOCUMENTO ====================

model ModeloDocumento {
  id            String   @id @default(cuid())
  nome          String
  descricao     String?
  tipoPeca      String
  conteudo      String
  arquivoUrl    String?  // URL do arquivo .docx modelo
  variaveis     String?
  ativo         Boolean  @default(true)

  escritorioId  String?
  escritorio    Escritorio? @relation(fields: [escritorioId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("modelos_documento")
}

// ==================== PASTAS E ORGANIZAÇÃO ====================

model Pasta {
  id            String   @id @default(cuid())
  nome          String
  cor           String   @default("#3b82f6")
  icone         String   @default("folder")

  pastaParentId String?
  pastaParent   Pasta?   @relation("SubPastas", fields: [pastaParentId], references: [id])
  subPastas     Pasta[]  @relation("SubPastas")

  escritorioId  String?
  escritorio    Escritorio? @relation(fields: [escritorioId], references: [id])

  pedidos       Pedido[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("pastas")
}

model Tag {
  id        String   @id @default(cuid())
  nome      String
  cor       String   @default("#6b7280")

  pedidos   PedidoTag[]

  createdAt DateTime @default(now())

  @@map("tags")
}

model PedidoTag {
  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pedidoId, tagId])
  @@map("pedido_tags")
}

// ==================== PEDIDOS ====================

model Pedido {
  id              String    @id @default(cuid())
  titulo          String
  tipoPeca        String

  nomeCliente     String?

  processoNumero  String?
  vara            String?
  parteAutora     String?
  parteRe         String?
  tribunal        String?
  comarca         String?

  observacoes     String?

  // Status principal
  status          String    @default("pendente")

  // Etapa atual do processamento (para exibição visual)
  etapaAtual      String    @default("aguardando") // aguardando, lendo, escrevendo, validando, formatando, concluido
  etapaProgresso  Int       @default(0) // 0-100

  pecaGerada      String?
  pecaFormatada   String?

  confirmado      Boolean   @default(false)
  confirmadoEm    DateTime?

  favorito        Boolean   @default(false)

  pastaId         String?
  pasta           Pasta?    @relation(fields: [pastaId], references: [id])

  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentos      Documento[]
  mensagens       Mensagem[]
  versoes         PecaVersao[]
  comentarios     Comentario[]
  tags            PedidoTag[]
  prazos          Prazo[]
  notificacoes    Notificacao[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("pedidos")
}

model Documento {
  id          String   @id @default(cuid())
  nome        String
  nomeArquivo String
  tipo        String
  tamanho     Int
  caminho     String

  metadados   String?

  pedidoId    String?
  pedido      Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@map("documentos")
}

model Mensagem {
  id        String   @id @default(cuid())
  conteudo  String
  remetente String

  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("mensagens")
}

// ==================== HISTÓRICO DE VERSÕES ====================

model PecaVersao {
  id          String   @id @default(cuid())
  versao      Int
  conteudo    String
  descricao   String?

  pedidoId    String
  pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@map("peca_versoes")
}

// ==================== BIBLIOTECA DE TESES ====================

model Tese {
  id            String   @id @default(cuid())
  titulo        String
  descricao     String?
  conteudo      String
  areaDireito   String
  tags          String?  // Separadas por vírgula
  fontes        String?

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  escritorioId  String?
  escritorio    Escritorio? @relation(fields: [escritorioId], references: [id])

  favorito      Boolean  @default(false)
  usosCount     Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("teses")
}

// ==================== COMENTÁRIOS ====================

model Comentario {
  id          String   @id @default(cuid())
  conteudo    String
  posicao     Int?
  resolvido   Boolean  @default(false)

  pedidoId    String
  pedido      Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("comentarios")
}

// ==================== PRAZOS PROCESSUAIS ====================

model Prazo {
  id              String   @id @default(cuid())
  titulo          String
  descricao       String?
  dataVencimento  DateTime

  tipo            String   @default("judicial")
  prioridade      String   @default("media")
  status          String   @default("pendente")

  processoNumero  String?
  nomeCliente     String?

  lembrete        Boolean  @default(true)
  diasLembrete    Int      @default(3)
  lembreteEnviado Boolean  @default(false)

  pedidoId        String?
  pedido          Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  userId          String
  user            User     @relation(fields: [userId], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("prazos")
}

// ==================== NOTIFICAÇÕES ====================

model Notificacao {
  id          String   @id @default(cuid())
  titulo      String
  mensagem    String
  tipo        String
  lida        Boolean  @default(false)
  link        String?

  pedidoId    String?
  pedido      Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  prazoId     String?

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@map("notificacoes")
}

// ==================== ESTATÍSTICAS ====================

model Estatistica {
  id              String   @id @default(cuid())
  data            DateTime @default(now())

  pedidosCriados  Int      @default(0)
  pedidosConcluidos Int    @default(0)
  documentosUpload Int     @default(0)
  tempoMedioProcessamento Int @default(0)

  userId          String?
  escritorioId    String?

  @@map("estatisticas")
}
